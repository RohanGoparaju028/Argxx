# Create an isolated artifact root, never the user's project artifacts.
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef RUN_ID)
set(TEST_DIR "${TEST_ROOT}/${RUN_ID}")
file(MAKE_DIRECTORY "${TEST_DIR}")
execute_process(COMMAND "${AGENT}" init --artifacts "${TEST_DIR}"
    RESULT_VARIABLE RESULT OUTPUT_QUIET ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0 OR NOT EXISTS "${TEST_DIR}/configs/repair.json")
    message(FATAL_ERROR "init failed: ${ERROR}")
endif()
execute_process(COMMAND "${AGENT}" repair --task missing --repo irrelevant
    RESULT_VARIABLE RESULT OUTPUT_QUIET ERROR_QUIET)
if(NOT RESULT EQUAL 2)
    message(FATAL_ERROR "Conflicting options must fail with exit 2")
endif()
execute_process(COMMAND "${AGENT}" package --artifacts "${TEST_DIR}"
    RESULT_VARIABLE RESULT OUTPUT_QUIET ERROR_VARIABLE ERROR)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "package failed: ${ERROR}")
endif()
file(GLOB ARCHIVES "${TEST_DIR}/argxx-bundle-*.zip")
list(LENGTH ARCHIVES ARCHIVE_COUNT)
if(NOT ARCHIVE_COUNT EQUAL 1)
    message(FATAL_ERROR "Expected one ZIP")
endif()
list(GET ARCHIVES 0 ARCHIVE)
file(MAKE_DIRECTORY "${TEST_DIR}/unpacked")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${ARCHIVE}"
    WORKING_DIRECTORY "${TEST_DIR}/unpacked" RESULT_VARIABLE RESULT)
if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "Cannot extract bundle")
endif()
foreach(ENTRY agent.json manifest.json bin/agent configs/repair.json prompts/system.md training/train_lora.py)
    if(NOT EXISTS "${TEST_DIR}/unpacked/${ENTRY}")
        message(FATAL_ERROR "Missing bundle entry: ${ENTRY}")
    endif()
endforeach()
file(READ "${TEST_DIR}/unpacked/manifest.json" MANIFEST)
string(JSON ADAPTER GET "${MANIFEST}" trained_adapter_present)
if(ADAPTER)
    message(FATAL_ERROR "Bundle falsely claims trained weights")
endif()
string(JSON HASH GET "${MANIFEST}" files bin/agent)
file(SHA256 "${TEST_DIR}/unpacked/bin/agent" ACTUAL_HASH)
if(NOT HASH STREQUAL ACTUAL_HASH)
    message(FATAL_ERROR "Binary checksum mismatch")
endif()
execute_process(COMMAND "${TEST_DIR}/unpacked/bin/agent" --version RESULT_VARIABLE RESULT OUTPUT_VARIABLE VERSION)
if(NOT RESULT EQUAL 0 OR NOT VERSION MATCHES "Argxx 0.2.0")
    message(FATAL_ERROR "Unpacked binary did not run")
endif()
file(REMOVE_RECURSE "${TEST_DIR}")
